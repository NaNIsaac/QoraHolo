{
  "version": 6,
  "cmakeMinimumRequired": {"major": 3, "minor": 28, "patch": 0},
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "cpu-debug",
      "inherits": "base",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug"}
    },
    {
      "name": "cpu-release",
      "inherits": "base",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Release"}
    },
    {
      "name": "cuda-release",
      "inherits": "base",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Release", "QORAHOLO_CUDA": "ON"}
    }
  ],
  "buildPresets": [
    {"name": "cpu-debug", "configurePreset": "cpu-debug"},
    {"name": "cpu-release", "configurePreset": "cpu-release"},
    {"name": "cuda-release", "configurePreset": "cuda-release"}
  ],
  "testPresets": [
    {"name": "cpu-debug", "configurePreset": "cpu-debug", "output": {"outputOnFailure": true}},
    {"name": "cpu-release", "configurePreset": "cpu-release", "output": {"outputOnFailure": true}},
    {"name": "cuda-release", "configurePreset": "cuda-release", "output": {"outputOnFailure": true}}
  ]
}
